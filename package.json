{
  "name": "boilerplate-template",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "ios:build": "xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphoneos -configuration Debug CODE_SIGNING_ALLOWED=NO build",
    "ios:open": "open ios/App/App.xcodeproj",
    "ios:run": "bash scripts/run-ios-simulator.sh",
    "deploy": "vercel",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint frontend --ext ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "_fmt": "prettier 'frontend/**/*.ts'",
    "fmt": "npm run _fmt -- --write",
    "create:contract": "tsx scripts/create-contract.ts",
    "ledger:query": "tsx scripts/ledger-query.ts",
    "contracts:active": "tsx scripts/active-contracts.ts",
    "dars:build": "cd daml && dpm build",
    "dars:upload": "tsx scripts/upload-dar.ts"
  },
  "dependencies": {
    "@canton-network/core-splice-provider": "^0.23.0",
    "@canton-network/core-types": "^0.18.0",
    "@canton-network/core-wallet-dapp-rpc-client": "^0.22.0",
    "@canton-network/core-wallet-ui-components": "^0.23.0",
    "@canton-network/wallet-sdk": "^0.20.0",
    "@cantor8/wallet-connect-sdk": "^0.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fivenorth/loop-sdk": "^0.10.0",
    "@mysten/bcs": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toast": "^1.2.1",
    "@tanstack/react-query": "^5.51.23",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.30",
    "lucide-react": "^0.383.0",
    "pusher-js": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.26.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^20.14.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "dotenv": "16.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.3",
    "tree-kill": "1.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2",
    "vercel": "^35.2.4",
    "vite": "^5.2.0",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-notifier": "^0.1.5"
  }
}
