-- TruthOracle USDC-style token - Canton Network DAML contracts
-- Simplified token for Canton testnet

module Usdc where

-- Token balance held by a party
template TokenAccount
  with
    owner: Party
    balance: Int
    currency: Text  -- "USDC"
  where
    signatory owner

    choice Transfer : ()
      with
        receiver: Party
        amount: Int
      controller owner
      do
        assert (amount <= balance)
        assert (amount >= 0)
        return ()

    choice Mint : ContractId TokenAccount
      with
        amount: Int
      controller owner
      do
        assert (amount >= 0)
        create TokenAccount with owner = owner, balance = balance + amount, currency = currency

-- Metadata for the token (single instance)
template TokenMetadata
  with
    issuer: Party
    symbol: Text
    decimals: Int
  where
    signatory issuer
