-- Daml Script test suite for the TruthOracle dynamic pm-AMM, the tiered
-- resolution model (T0-T3), and the in-app UserWallet collateral rail.
module TruthoracleTest where

import DA.Assert ((===))
import DA.Foldable (forA_)
import Daml.Script
import PmAmmMath
import Truthoracle

-- Times (epoch seconds) used across scenarios.
t0, tTrade, tExpiry, tAfterExpiry, tAfterGrace : Int
t0 = 1000000
tTrade = 1010000
tExpiry = 1086400            -- t0 + 1 day
tAfterExpiry = 1090000
tAfterGrace = 1200000        -- past expiry + 1 day grace

grace : Int
grace = 86_400

approxEq : Decimal -> Decimal -> Decimal -> Bool
approxEq tol a b = abs (a - b) <= tol

defaultPolicy : ResolutionPolicy
defaultPolicy = ResolutionPolicy with
  operatorResolution = True
  sources = ["https://example.com/result"]
  sourceKeys = []
  reporters = []
  quorum = 0
  challengeSecs = 0
  bondCC = 0.0

setup : Script (Party, Party, Party)
setup = do
  admin <- allocateParty "Admin"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  return (admin, alice, bob)

createCounter : Party -> Script (ContractId MarketCounter)
createCounter admin =
  submit admin do
    createCmd MarketCounter with admin; value = 0

-- Create a user's in-app wallet and credit an initial external deposit.
mkWallet : Party -> Party -> Decimal -> Script (ContractId UserWallet)
mkWallet admin owner amount = do
  wCid <- submit admin do
    createCmd UserWallet with
      admin, owner
      balanceCC = 0.0
      depositedCC = 0.0
      withdrawnCC = 0.0
      depositRefs = None
  if amount > 0.0
    then submit admin do
      exerciseCmd wCid Deposit with amountCC = amount, txRef = "0xdeposit"
    else return wCid

walletBalance : Party -> ContractId UserWallet -> Script Decimal
walletBalance p cid = do
  wOpt <- queryContractId p cid
  case wOpt of
    None -> abort "expected wallet visible"
    Some w -> return w.balanceCC

mkMarket
  : Party -> ContractId MarketCounter -> ResolutionPolicy -> Bool -> Decimal -> Decimal
 -> Script (ContractId MarketCounter, ContractId PredictionMarket, ContractId LiquidityPosition)
mkMarket admin counterCid policy isDynamic p0 v0 =
  submit admin do
    exerciseCmd counterCid CreateMarket with
      question = "Will Liverpool beat Brighton on 13 May 2026?"
      imageUrl = "https://example.com/market.png"
      description = "pm-AMM lifecycle test market"
      resolutionDescription = "Opta full-time scoreline"
      category = "Sports"
      createdAt = t0
      expiresAt = tExpiry
      gracePeriodSecs = grace
      isDynamic
      liquidityPeriodSecs = 0
      initialProbability = p0
      initialValueCC = v0
      feeBps = 30
      prizeFeeShareBps = 2000
      policy
      auditObservers = []

fetchMarket : Party -> ContractId PredictionMarket -> Script PredictionMarket
fetchMarket p cid = do
  mOpt <- queryContractId p cid
  case mOpt of
    None -> abort "expected market visible"
    Some m -> return m

-- ---------------------------------------------------------------------------
-- pm-AMM math invariants (D-A2)
-- ---------------------------------------------------------------------------

pmAmmMathInvariants : Script ()
pmAmmMathInvariants = do
  -- Normal distribution sanity.
  assert (approxEq 0.0001 0.5 (normCdf 0.0))
  assert (approxEq 0.0005 0.8413447461 (normCdf 1.0))
  assert (approxEq 0.001 1.6448536270 (normInvCdf 0.95))
  assert (approxEq 0.0001 0.3989422804 (normPdf 0.0))
  -- Round trip: cdf(icdf(p)) == p across the simplex.
  let ps = [0.05, 0.2, 0.5, 0.7, 0.95]
  forA_ ps (\p -> assert (approxEq 0.001 p (normCdf (normInvCdf p))))
  -- Closed-form reserves satisfy the invariant and reproduce the price.
  forA_ ps (\p -> do
    let l = 100.0
        (x, y) = optimalReserves p l
    assert (approxEq 0.01 0.0 (invariantValue x y l))
    assert (approxEq 0.005 p (priceFromReserves x y l))
    -- Pool value closed form: V = L * pdf(icdf P).
    assert (approxEq 0.01 (poolValue p l) (l * normPdf (normInvCdf p))))
  -- Time decay: L_eff = L0 * sqrt((T-t)/(T-t0)); halfway -> sqrt(0.5).
  let lEffHalf = effectiveLiquidity True 100.0 0 100 50
  assert (approxEq 0.01 70.7106781 lEffHalf)
  effectiveLiquidity False 100.0 0 100 50 === 100.0
  -- Buy/sell round trip loses only rounding + spread, never mints value.
  let l = 100.0
      (x, y) = optimalReserves 0.5 l
      n = solveBuyShares x y l 10.0
  -- 10 CC at ~0.5 must buy more than 10 but fewer than 20 YES.
  assert (n > 10.0 && n < 20.0)
  let c = solveSellProceeds (x + 10.0 - n) (y + 10.0) l n
  assert (c <= 10.0 + 0.01 && c > 8.0)

-- ---------------------------------------------------------------------------
-- In-app wallet: deposit / debit-auth / withdraw / cancel-refund (wallet rail)
-- ---------------------------------------------------------------------------

inAppWalletLifecycle : Script ()
inAppWalletLifecycle = do
  (admin, alice, bob) <- setup
  aliceW <- mkWallet admin alice 50.0
  wOpt <- queryContractId alice aliceW
  case wOpt of
    None -> abort "expected wallet visible"
    Some w -> do
      w.balanceCC === 50.0
      w.depositedCC === 50.0
      w.withdrawnCC === 0.0
      w.depositRefs === Some ["0xdeposit"]

  -- Crediting the same external transfer twice is rejected on-ledger; a fresh
  -- txRef appends to the record. Exercised on bob's wallet so alice's flow below
  -- stays on known balances.
  bobW <- mkWallet admin bob 5.0
  submitMustFail admin do
    exerciseCmd bobW Deposit with amountCC = 1.0, txRef = "0xdeposit"
  bobW <- submit admin do
    exerciseCmd bobW Deposit with amountCC = 10.0, txRef = "0xdeposit2"
  bOpt <- queryContractId bob bobW
  case bOpt of
    None -> abort "expected wallet visible"
    Some w -> do
      w.balanceCC === 15.0
      w.depositedCC === 15.0
      w.depositRefs === Some ["0xdeposit2", "0xdeposit"]

  -- Neither the owner nor the admin can debit unilaterally.
  submitMustFail alice do
    exerciseCmd aliceW Debit with amountCC = 5.0, reason = "steal"
  submitMustFail admin do
    exerciseCmd aliceW Debit with amountCC = 5.0, reason = "steal"
  -- A third party cannot withdraw from someone else's wallet.
  submitMustFail bob do
    exerciseCmd aliceW Withdraw with amountCC = 5.0, nowSeconds = t0
  -- Over-withdrawal is rejected.
  submitMustFail alice do
    exerciseCmd aliceW Withdraw with amountCC = 60.0, nowSeconds = t0

  -- Withdraw 20: balance debited, PendingPayout queued for the admin.
  (aliceW, payoutCid) <- submit alice do
    exerciseCmd aliceW Withdraw with amountCC = 20.0, nowSeconds = t0
  wOpt2 <- queryContractId alice aliceW
  case wOpt2 of
    None -> abort "expected wallet visible"
    Some w -> do
      w.balanceCC === 30.0
      w.withdrawnCC === 20.0
  pOpt <- queryContractId alice payoutCid
  case pOpt of
    None -> abort "expected payout visible"
    Some p -> do
      p.reason === "withdraw"
      p.amountCC === 20.0
      p.marketId === 0

  -- Cancel with a refund target re-credits the in-app balance.
  refund <- submit alice do
    exerciseCmd payoutCid CancelPayout with refundWalletCid = Some aliceW
  aliceW <- case refund of
    None -> abort "expected refund credit"
    Some wCid -> return wCid
  bal <- walletBalance alice aliceW
  bal === 50.0

  -- Buys are capped by the in-app balance, and only the wallet's owner can
  -- spend it.
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin counterCid defaultPolicy True 0.5 100.0
  submitMultiMustFail [alice] [admin] do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      collateralCC = 100.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW
  submitMultiMustFail [bob] [admin] do
    exerciseCmd marketCid Buy with
      buyer = bob
      side = Yes
      collateralCC = 10.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW

-- ---------------------------------------------------------------------------
-- Lifecycle: create -> buy -> sell -> resolve (T0) -> redeem (D-A2, D-B1)
-- ---------------------------------------------------------------------------

lifecycleBuySellResolveRedeem : Script ()
lifecycleBuySellResolveRedeem = do
  (admin, alice, bob) <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin counterCid defaultPolicy True 0.5 100.0
  aliceW <- mkWallet admin alice 100.0
  bobW <- mkWallet admin bob 50.0

  m0 <- fetchMarket admin marketCid
  m0.currentPrice === 0.5
  m0.status === Trading
  assert (m0.liquidityL > 0.0)

  -- Alice buys YES with 10 CC debited from her in-app wallet.
  (marketCid, alicePosCid, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      collateralCC = 10.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW
  aliceBal1 <- walletBalance alice aliceW
  aliceBal1 === 90.0

  m1 <- fetchMarket admin marketCid
  assert (m1.currentPrice > 0.5)  -- YES demand moves the price up
  assert (m1.currentPrice < 1.0)
  assert (m1.accumulatedFeesCC > 0.0)
  assert (m1.prizePoolCC > 0.0)
  m1.totalVolumeCC === 10.0

  Some alicePos <- queryContractId alice alicePosCid
  assert (alicePos.yesShares > 10.0)  -- bought below 1.0/share
  alicePos.costBasisCC === 10.0

  -- Bob buys NO, price comes back down.
  (marketCid, _, bobW) <- submitMulti [bob] [admin] do
    exerciseCmd marketCid Buy with
      buyer = bob
      side = No
      collateralCC = 5.0
      minSharesOut = 1.0
      nowSeconds = tTrade + 100
      existingPosition = None
      walletCid = bobW
  bobBal1 <- walletBalance bob bobW
  bobBal1 === 45.0
  m2 <- fetchMarket admin marketCid
  assert (m2.currentPrice < m1.currentPrice)

  -- Alice sells half her YES back; net proceeds land in her wallet instantly.
  let sellShares = 5.0
  (marketCid, alicePosCid, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid Sell with
      seller = alice
      side = Yes
      sharesIn = sellShares
      minProceedsCC = 0.5
      nowSeconds = tTrade + 200
      positionCid = alicePosCid
      walletCid = aliceW
  aliceBal2 <- walletBalance alice aliceW
  -- Proceeds are positive but below 1 CC/share.
  assert (aliceBal2 > 90.0 && aliceBal2 < 90.0 + sellShares)

  -- Too-early resolution is rejected.
  submitMustFail admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = Yes
      sourceUri = "https://example.com/result"
      nowSeconds = tTrade
  -- Non-allowlisted source is rejected.
  submitMustFail admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = Yes
      sourceUri = "https://evil.example.com"
      nowSeconds = tAfterExpiry

  -- T0 resolve to YES.
  marketCid <- submit admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = Yes
      sourceUri = "https://example.com/result"
      nowSeconds = tAfterExpiry
  m3 <- fetchMarket admin marketCid
  m3.status === Resolved
  m3.outcome === Some Yes

  -- Trading after resolution fails.
  submitMultiMustFail [alice] [admin] do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      collateralCC = 1.0
      minSharesOut = 0.1
      nowSeconds = tAfterExpiry
      existingPosition = None
      walletCid = aliceW

  -- Alice redeems: 1 CC per remaining winning YES share, into her wallet.
  Some aliceFinal <- queryContractId alice alicePosCid
  aliceW <- submitMulti [alice] [admin] do
    exerciseCmd marketCid RedeemPosition with
      holder = alice
      nowSeconds = tAfterExpiry + 100
      positionCid = alicePosCid
      walletCid = aliceW
  aliceBal3 <- walletBalance alice aliceW
  aliceBal3 === aliceBal2 + aliceFinal.yesShares

-- ---------------------------------------------------------------------------
-- Direct outcome-token swap (YES <-> NO)
-- ---------------------------------------------------------------------------

swapSharesBetweenOutcomes : Script ()
swapSharesBetweenOutcomes = do
  (admin, alice, _) <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin counterCid defaultPolicy True 0.5 100.0
  aliceW <- mkWallet admin alice 20.0

  -- Alice mints 10 complete sets, then swaps 5 NO -> YES.
  (posCid, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid Split with
      user = alice
      amount = 10.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW
  bal <- walletBalance alice aliceW
  bal === 10.0
  m0 <- fetchMarket admin marketCid

  (marketCid, posCid) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid SwapShares with
      swapper = alice
      fromSide = No
      sharesIn = 5.0
      minSharesOut = 1.0
      nowSeconds = tTrade + 10
      positionCid = posCid
  Some pos <- queryContractId alice posCid
  pos.noShares === 5.0
  -- Swapping NO in at ~50% yields roughly as many YES out (minus fee/impact).
  assert (pos.yesShares > 13.0 && pos.yesShares < 15.0)
  m1 <- fetchMarket admin marketCid
  -- Buying pressure on YES (NO in, YES out) moves the YES price up.
  assert (m1.currentPrice > m0.currentPrice)

  -- Cannot swap more than held.
  submitMultiMustFail [alice] [admin] do
    exerciseCmd marketCid SwapShares with
      swapper = alice
      fromSide = No
      sharesIn = 50.0
      minSharesOut = 1.0
      nowSeconds = tTrade + 20
      positionCid = posCid

-- ---------------------------------------------------------------------------
-- Pre-trading liquidity-collection window (dynamic pools)
-- ---------------------------------------------------------------------------

liquidityPeriodGatesTrading : Script ()
liquidityPeriodGatesTrading = do
  (admin, alice, _) <- setup
  counterCid <- createCounter admin
  aliceW <- mkWallet admin alice 100.0
  let periodSecs = 3600
  (_, marketCid, _) <- submit admin do
    exerciseCmd counterCid CreateMarket with
      question = "Liquidity-period market?"
      imageUrl = ""
      description = "dynamic pool with a pre-trading collection window"
      resolutionDescription = "operator"
      category = "Sports"
      createdAt = t0
      expiresAt = tExpiry
      gracePeriodSecs = grace
      isDynamic = True
      liquidityPeriodSecs = periodSecs
      initialProbability = 0.5
      initialValueCC = 100.0
      feeBps = 30
      prizeFeeShareBps = 0
      policy = defaultPolicy
      auditObservers = []

  let duringPeriod = t0 + 100
  -- Buys are blocked during the collection window...
  submitMultiMustFail [alice] [admin] do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      collateralCC = 5.0
      minSharesOut = 1.0
      nowSeconds = duringPeriod
      existingPosition = None
      walletCid = aliceW
  -- ...but minting complete sets and providing liquidity are allowed.
  (posCid, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid Split with
      user = alice
      amount = 3.0
      nowSeconds = duringPeriod
      existingPosition = None
      walletCid = aliceW
  balAfterSplit <- walletBalance alice aliceW
  balAfterSplit === 97.0
  (marketCid, _, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid ProvideLiquidity with
      provider = alice
      valueIncreaseCC = 10.0
      maxCostCC = 50.0
      nowSeconds = duringPeriod
      existingLpPosition = None
      walletCid = aliceW
  balAfterLp <- walletBalance alice aliceW
  assert (balAfterLp < balAfterSplit)
  -- After the window, trading opens.
  (marketCid, _, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      collateralCC = 5.0
      minSharesOut = 1.0
      nowSeconds = t0 + periodSecs + 10
      existingPosition = Some posCid
      walletCid = aliceW
  balAfterBuy <- walletBalance alice aliceW
  balAfterBuy === balAfterLp - 5.0
  m <- fetchMarket admin marketCid
  assert (m.currentPrice > 0.5)

-- ---------------------------------------------------------------------------
-- Split / Merge complete sets
-- ---------------------------------------------------------------------------

splitMergeCompleteSets : Script ()
splitMergeCompleteSets = do
  (admin, alice, _) <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin counterCid defaultPolicy False 0.4 50.0
  aliceW <- mkWallet admin alice 20.0

  (posCid, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid Split with
      user = alice
      amount = 7.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW
  Some pos <- queryContractId alice posCid
  pos.yesShares === 7.0
  pos.noShares === 7.0
  pos.costBasisCC === 7.0
  bal1 <- walletBalance alice aliceW
  bal1 === 13.0

  (posCid, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid Merge with
      user = alice
      amount = 3.0
      nowSeconds = tTrade + 10
      positionCid = posCid
      walletCid = aliceW
  Some pos2 <- queryContractId alice posCid
  pos2.yesShares === 4.0
  pos2.noShares === 4.0
  bal2 <- walletBalance alice aliceW
  bal2 === 16.0

  -- Over-merge fails.
  submitMultiMustFail [alice] [admin] do
    exerciseCmd marketCid Merge with
      user = alice
      amount = 100.0
      nowSeconds = tTrade + 20
      positionCid = posCid
      walletCid = aliceW

-- ---------------------------------------------------------------------------
-- Value-based liquidity provision and withdrawal (D-A2)
-- ---------------------------------------------------------------------------

liquidityProvisionAndWithdrawal : Script ()
liquidityProvisionAndWithdrawal = do
  (admin, alice, _) <- setup
  counterCid <- createCounter admin
  -- Static pool so early withdrawal is allowed.
  (_, marketCid, _) <- mkMarket admin counterCid defaultPolicy False 0.5 100.0
  aliceW <- mkWallet admin alice 100.0
  m0 <- fetchMarket admin marketCid

  (marketCid, lpCid, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid ProvideLiquidity with
      provider = alice
      valueIncreaseCC = 25.0
      maxCostCC = 100.0
      nowSeconds = tTrade
      existingLpPosition = None
      walletCid = aliceW
  m1 <- fetchMarket admin marketCid
  -- Value-based deposit leaves the price unchanged and scales L by (V+dV)/V.
  m1.currentPrice === m0.currentPrice
  assert (approxEq 0.01 (m0.liquidityL * 1.25) m1.liquidityL)
  assert (m1.lpTokenSupply > m0.lpTokenSupply)
  Some lp <- queryContractId alice lpCid
  assert (lp.lpTokens > 0.0)
  bal1 <- walletBalance alice aliceW
  assert (bal1 < 100.0)  -- provision cost debited

  -- Early exit (static): shares + fee split, LP burned. No trades happened,
  -- so the fee credit is zero and the wallet cid passes through unchanged.
  (marketCid, _, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid WithdrawLiquidity with
      provider = alice
      lpTokensToBurn = lp.lpTokens
      nowSeconds = tTrade + 100
      lpPositionCid = lpCid
      existingPosition = None
      walletCid = aliceW
  m2 <- fetchMarket admin marketCid
  assert (m2.lpTokenSupply < m1.lpTokenSupply)
  assert (m2.reserveYes < m1.reserveYes)
  bal2 <- walletBalance alice aliceW
  bal2 === bal1

dynamicLpLockedUntilResolution : Script ()
dynamicLpLockedUntilResolution = do
  (admin, alice, _) <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin counterCid defaultPolicy True 0.5 100.0
  aliceW <- mkWallet admin alice 100.0
  (marketCid, lpCid, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid ProvideLiquidity with
      provider = alice
      valueIncreaseCC = 10.0
      maxCostCC = 50.0
      nowSeconds = tTrade
      existingLpPosition = None
      walletCid = aliceW
  bal1 <- walletBalance alice aliceW
  -- Locked while trading.
  submitMultiMustFail [alice] [admin] do
    exerciseCmd marketCid WithdrawLiquidity with
      provider = alice
      lpTokensToBurn = 1.0
      nowSeconds = tTrade + 10
      lpPositionCid = lpCid
      existingPosition = None
      walletCid = aliceW
  -- After resolution the LP exits with winning reserve + fee share, credited
  -- straight to the in-app wallet.
  marketCid <- submit admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = No
      sourceUri = "https://example.com/result"
      nowSeconds = tAfterExpiry
  Some lp <- queryContractId alice lpCid
  (_, _, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid WithdrawLiquidity with
      provider = alice
      lpTokensToBurn = lp.lpTokens
      nowSeconds = tAfterExpiry + 10
      lpPositionCid = lpCid
      existingPosition = None
      walletCid = aliceW
  bal2 <- walletBalance alice aliceW
  assert (bal2 > bal1)

-- ---------------------------------------------------------------------------
-- T2 reporter quorum (D-B3)
-- ---------------------------------------------------------------------------

reporterQuorumResolves : Script ()
reporterQuorumResolves = do
  (admin, alice, _) <- setup
  r1 <- allocateParty "Reporter1"
  r2 <- allocateParty "Reporter2"
  r3 <- allocateParty "Reporter3"
  let policy = defaultPolicy with
        operatorResolution = False
        reporters = [r1, r2, r3]
        quorum = 2
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin counterCid policy True 0.5 100.0
  m <- fetchMarket admin marketCid

  -- T0 is disabled under this policy.
  submitMustFail admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = Yes
      sourceUri = "https://example.com/result"
      nowSeconds = tAfterExpiry

  let mkAtt reporter out = createCmd OutcomeAttestation with
        attester = reporter
        admin
        marketId = m.marketId
        sourceUri = "https://example.com/result"
        fetchedAt = tAfterExpiry
        outcome = out
        payloadHash = "deadbeef"
        sourceSignature = None
        responseExcerpt = Some "2-1"
  att1 <- submit r1 (mkAtt r1 Yes)
  att2 <- submit r2 (mkAtt r2 Yes)
  attBad <- submit r3 (mkAtt r3 No)

  -- Disagreeing attestations cannot resolve.
  submitMustFail admin do
    exerciseCmd marketCid Resolve with
      attestationCids = [att1, attBad]
      nowSeconds = tAfterExpiry + 10
  -- Sub-quorum cannot resolve.
  submitMustFail admin do
    exerciseCmd marketCid Resolve with
      attestationCids = [att1]
      nowSeconds = tAfterExpiry + 10
  -- 2-of-3 agreeing attestations resolve.
  marketCid <- submit admin do
    exerciseCmd marketCid Resolve with
      attestationCids = [att1, att2]
      nowSeconds = tAfterExpiry + 10
  m2 <- fetchMarket admin marketCid
  m2.status === Resolved
  m2.outcome === Some Yes

-- ---------------------------------------------------------------------------
-- T3 optimistic propose / challenge / finalize (D-B4)
-- ---------------------------------------------------------------------------

optimisticFinalizeUnchallenged : Script ()
optimisticFinalizeUnchallenged = do
  (admin, alice, bob) <- setup
  let policy = defaultPolicy with
        operatorResolution = False
        challengeSecs = 3600
        bondCC = 10.0
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin counterCid policy True 0.5 100.0
  bobW <- mkWallet admin bob 20.0

  -- Propose before expiry fails.
  submitMultiMustFail [bob] [admin] do
    exerciseCmd marketCid ProposeOutcome with
      proposer = bob
      proposedOutcome = Yes
      nowSeconds = tTrade
      walletCid = bobW
  -- Bob proposes YES; the bond is debited from his in-app wallet.
  (marketCid, bobW) <- submitMulti [bob] [admin] do
    exerciseCmd marketCid ProposeOutcome with
      proposer = bob
      proposedOutcome = Yes
      nowSeconds = tAfterExpiry
      walletCid = bobW
  bondBal <- walletBalance bob bobW
  bondBal === 10.0
  m <- fetchMarket admin marketCid
  m.status === Proposed
  -- Finalize inside the window fails.
  submitMultiMustFail [alice] [admin] do
    exerciseCmd marketCid FinalizeOutcome with
      finalizer = alice
      nowSeconds = tAfterExpiry + 100
  -- After the window, anyone finalizes; the bond returns to the proposer as
  -- a PendingPayout the admin can settle into the in-app wallet.
  marketCid <- submitMulti [alice] [admin] do
    exerciseCmd marketCid FinalizeOutcome with
      finalizer = alice
      nowSeconds = tAfterExpiry + 3700
  m2 <- fetchMarket admin marketCid
  m2.status === Resolved
  m2.outcome === Some Yes
  payouts <- query @PendingPayout bob
  bondPayoutCid <- case [cid | (cid, p) <- payouts, p.reason == "bond", p.user == bob, p.amountCC == 10.0] of
    (cid :: _) -> return cid
    [] -> abort "expected bond payout"
  bobW <- submit admin do
    exerciseCmd bondPayoutCid SettleToWallet with walletCid = bobW
  finalBal <- walletBalance bob bobW
  finalBal === 20.0

optimisticChallengeEscalatesToQuorum : Script ()
optimisticChallengeEscalatesToQuorum = do
  (admin, alice, bob) <- setup
  r1 <- allocateParty "ReporterA"
  r2 <- allocateParty "ReporterB"
  let policy = defaultPolicy with
        operatorResolution = False
        reporters = [r1, r2]
        quorum = 2
        challengeSecs = 3600
        bondCC = 10.0
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin counterCid policy True 0.5 100.0
  bobW <- mkWallet admin bob 20.0
  aliceW <- mkWallet admin alice 20.0
  m <- fetchMarket admin marketCid

  -- Bob proposes NO (wrongly); Alice challenges with YES. Both bonds are
  -- debited from their in-app wallets.
  (marketCid, bobW) <- submitMulti [bob] [admin] do
    exerciseCmd marketCid ProposeOutcome with
      proposer = bob
      proposedOutcome = No
      nowSeconds = tAfterExpiry
      walletCid = bobW
  bobBal <- walletBalance bob bobW
  bobBal === 10.0
  (marketCid, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid ChallengeOutcome with
      challenger = alice
      challengerOutcome = Yes
      nowSeconds = tAfterExpiry + 100
      walletCid = aliceW
  aliceBal <- walletBalance alice aliceW
  aliceBal === 10.0
  -- A challenged proposal cannot be finalized - it must escalate.
  submitMultiMustFail [bob] [admin] do
    exerciseCmd marketCid FinalizeOutcome with
      finalizer = bob
      nowSeconds = tAfterExpiry + 3700
  -- Reporters attest YES; Resolve settles and slashes Bob's bond to Alice.
  let mkAtt reporter = createCmd OutcomeAttestation with
        attester = reporter
        admin
        marketId = m.marketId
        sourceUri = "https://example.com/result"
        fetchedAt = tAfterExpiry + 200
        outcome = Yes
        payloadHash = "deadbeef"
        sourceSignature = None
        responseExcerpt = None
  att1 <- submit r1 (mkAtt r1)
  att2 <- submit r2 (mkAtt r2)
  marketCid <- submit admin do
    exerciseCmd marketCid Resolve with
      attestationCids = [att1, att2]
      nowSeconds = tAfterExpiry + 300
  m2 <- fetchMarket admin marketCid
  m2.status === Resolved
  m2.outcome === Some Yes
  payouts <- query @PendingPayout alice
  winCid <- case [cid | (cid, p) <- payouts, p.reason == "bond", p.user == alice, p.amountCC == 20.0] of
    (cid :: _) -> return cid
    [] -> abort "expected slashed-bond payout"
  aliceW <- submit admin do
    exerciseCmd winCid SettleToWallet with walletCid = aliceW
  aliceFinal <- walletBalance alice aliceW
  aliceFinal === 30.0

-- ---------------------------------------------------------------------------
-- Void path (expired without resolution) and void refunds (D-B1)
-- ---------------------------------------------------------------------------

voidRefundsCostBasis : Script ()
voidRefundsCostBasis = do
  (admin, alice, _) <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin counterCid defaultPolicy True 0.5 100.0
  aliceW <- mkWallet admin alice 10.0
  (marketCid, posCid, aliceW) <- submitMulti [alice] [admin] do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      collateralCC = 8.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW
  bal1 <- walletBalance alice aliceW
  bal1 === 2.0
  -- Void before grace elapses fails.
  submitMustFail admin do
    exerciseCmd marketCid VoidMarket with nowSeconds = tAfterExpiry
  marketCid <- submit admin do
    exerciseCmd marketCid VoidMarket with nowSeconds = tAfterGrace
  m <- fetchMarket admin marketCid
  m.status === Voided
  -- The void refund credits the cost basis back to the in-app wallet.
  aliceW <- submitMulti [alice] [admin] do
    exerciseCmd marketCid RedeemPosition with
      holder = alice
      nowSeconds = tAfterGrace + 10
      positionCid = posCid
      walletCid = aliceW
  bal2 <- walletBalance alice aliceW
  bal2 === 10.0

-- ---------------------------------------------------------------------------
-- Prediction-model marketplace: commit-before-outcome + Brier scoring (D-E1)
-- ---------------------------------------------------------------------------

forecastCommitAndScoring : Script ()
forecastCommitAndScoring = do
  (admin, alice, bob) <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin counterCid defaultPolicy True 0.5 100.0
  bobW <- mkWallet admin bob 200.0

  -- Trade to fund the prize pool (20% of the 0.3% fee).
  (marketCid, _, bobW) <- submitMulti [bob] [admin] do
    exerciseCmd marketCid Buy with
      buyer = bob
      side = Yes
      collateralCC = 100.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = bobW
  m <- fetchMarket admin marketCid
  assert (m.prizePoolCC > 0.0)

  -- Alice's model is confident YES (beats the market price), Bob's says NO.
  fAlice <- submitMulti [alice] [admin] do
    exerciseCmd marketCid CommitForecast with
      author = alice
      modelId = "alice-model-1"
      probabilityYes = 0.9
      nowSeconds = tTrade + 10
  fBob <- submitMulti [bob] [admin] do
    exerciseCmd marketCid CommitForecast with
      author = bob
      modelId = "bob-model-1"
      probabilityYes = 0.1
      nowSeconds = tTrade + 10
  -- Forecasts cannot be committed after expiry (commit-before-outcome).
  submitMultiMustFail [alice] [admin] do
    exerciseCmd marketCid CommitForecast with
      author = alice
      modelId = "alice-model-1"
      probabilityYes = 0.99
      nowSeconds = tAfterExpiry

  marketCid <- submit admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = Yes
      sourceUri = "https://example.com/result"
      nowSeconds = tAfterExpiry
  marketCid <- submit admin do
    exerciseCmd marketCid ScoreAndDistribute with
      forecastCids = [fAlice, fBob]
      nowSeconds = tAfterExpiry + 10
  m2 <- fetchMarket admin marketCid
  m2.prizePoolCC === 0.0
  -- Only Alice beat the market; she gets the whole pool.
  alicePrizes <- query @PendingPayout alice
  assert (any (\(_, p) -> p.reason == "model-prize" && p.user == alice) alicePrizes)
  bobPrizes <- query @PendingPayout bob
  assert (not (any (\(_, p) -> p.reason == "model-prize" && p.user == bob) bobPrizes))
