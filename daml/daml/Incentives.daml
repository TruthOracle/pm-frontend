-- TruthOracle Incentives - Canton Network DAML contracts
-- Rewards: early participant, market creator, winning prediction

module Incentives where

import DA.List (dedup)

-- Reward type
data RewardType = EarlyParticipant | CreatorReward | WinningPrediction
  deriving (Eq, Show)

-- One row in a batch claim (Ledger API / JSON maps to this record)
data RewardClaim = RewardClaim
  with
    marketId : Int
    rewardType : RewardType
    amount : Int
  deriving (Eq, Show)

-- Claimed reward record
template ClaimedReward
  with
    user: Party
    marketId: Int
    rewardType: RewardType
    amount: Int
  where
    signatory user

-- User rewards summary (view)
template UserRewardsSummary
  with
    user: Party
    totalEarned: Int
    claimedMarkets: [Int]
  where
    signatory user

    -- Single claim: archives this summary and creates an updated one (do not batch multiple
    -- ClaimReward on the same contract id in one submission).
    choice ClaimReward : (ContractId ClaimedReward, ContractId UserRewardsSummary)
      with
        marketId: Int
        rewardType: RewardType
        amount: Int
      controller user
      do
        assert (not (elem marketId claimedMarkets))
        rewardCid <- create ClaimedReward with
          user = user
          marketId = marketId
          rewardType = rewardType
          amount = amount
        summaryCid <- create UserRewardsSummary with
          user = user
          totalEarned = totalEarned + amount
          claimedMarkets = marketId :: claimedMarkets
        return (rewardCid, summaryCid)

    -- Preferred for "claim all": one exercise, many ClaimedReward + one new summary.
    choice ClaimRewardsBatch : (ContractId UserRewardsSummary, [ContractId ClaimedReward])
      with
        claims : [RewardClaim]
      controller user
      do
        assert (not (null claims))
        let newIds = map (\c -> c.marketId) claims
        assert (newIds == dedup newIds)
        assert (all (\m -> not (elem m claimedMarkets)) newIds)
        rewardCids <- mapA (\c -> create ClaimedReward with
            user = user
            marketId = c.marketId
            rewardType = c.rewardType
            amount = c.amount) claims
        let delta = foldl (\acc c -> acc + c.amount) 0 claims
        summaryCid <- create UserRewardsSummary with
          user = user
          totalEarned = totalEarned + delta
          claimedMarkets = claimedMarkets ++ newIds
        return (summaryCid, rewardCids)

-- Constants (in real DAML you'd use these in choices; amounts in Canton Coin base units)
-- EARLY_PARTICIPANT_THRESHOLD = 100000000  -- 1 Canton Coin
-- EARLY_PARTICIPANT_REWARD = 5000000       -- 0.05 Canton Coin
-- MARKET_CREATOR_REWARD = 10000000        -- 0.1 Canton Coin
-- WINNING_PREDICTION_BONUS = 20000000      -- 0.2 Canton Coin
