-- TruthOracle Prediction Market - Canton Network Daml contracts
-- Implements the TruthOracle proposal v0.6 / implementation plan v1.1:
--   * Market with an inline *dynamic* pm-AMM (Gaussian score dynamics):
--       P(YES) = cdf((y - x) / L_eff),  L_eff = L0 * sqrt((T - t)/(T - t0))
--     Trades run against virtual reserves derived closed-form from the cached
--     price (the cached-price / virtual-reserve execution model), while
--     physical reserves custody inventory for solvency accounting.
--   * Position (holder-signed outcome shares), LiquidityPosition (pro-rata
--     claim on the pool), OutcomeAttestation (signed source reading).
--   * Tiered objective resolution:
--       T0 designated operator, T1 first-party secp256k1-signed source,
--       T2 M-of-N reporter quorum, T3 optimistic propose/challenge/finalize
--       with bonds and objective escalation to T1/T2.
--   * Void as a first-class outcome (cost-basis refunds).
--
-- Collateral rails (in-app wallet architecture):
--   * UserWallet: a per-user on-ledger CC balance custodied by the admin
--     treasury. Deposits are real CC transfers (Cantor8 / any Canton wallet)
--     to the admin, which the admin then credits via Deposit; the contract
--     does NOT verify the transfer - reconcile off-chain. The trust boundary
--     is confined to deposit/withdraw instead of every trade.
--   * Buy / Split / ProvideLiquidity / T3 bonds: debit the user's UserWallet
--     atomically inside the exercising transaction - one wallet action per
--     trade, no prior CC-transfer popup.
--   * Sell / Merge / Redeem / WithdrawLiquidity: credit the UserWallet
--     atomically - proceeds are spendable immediately, no payout batching.
--   * External withdrawals and admin-driven payouts (T3 bond settlement,
--     model prizes) still go through PendingPayout: the admin settles either
--     off-ledger via the Enterprise Wallet (MarkPaid) or into the in-app
--     balance (SettleToWallet).

module Truthoracle where

import DA.Action (when)
import DA.List (dedup, head)
import DA.Optional (isNone, fromOptional)
import DA.Crypto.Text (secp256k1, isHex)
import DA.Text qualified as T
import PmAmmMath

-- Even-length hex check (DA.Crypto.Text's isBytesHex is not exported).
isBytesHex : Text -> Bool
isBytesHex t = isHex t && T.length t % 2 == 0

-- ---------------------------------------------------------------------------
-- Shared types
-- ---------------------------------------------------------------------------

data Outcome = Yes | No | VoidOutcome
  deriving (Eq, Ord, Show)

data MarketStatus = Trading | Proposed | Resolved | Voided
  deriving (Eq, Show)

-- (sourceUri, pinned secp256k1 public key) for T1 first-party verification.
data SourceKey = SourceKey with
    sourceUri : Text
    publicKey : Text   -- DER-formatted hex public key
  deriving (Eq, Show)

-- Which resolution tiers a Market enables. Immutable after creation.
data ResolutionPolicy = ResolutionPolicy with
    operatorResolution : Bool   -- T0: designated operator may resolve directly
    sources : [Text]            -- allowlisted source URIs
    sourceKeys : [SourceKey]    -- T1: pinned per-source public keys
    reporters : [Party]         -- T2: allowlisted reporter parties
    quorum : Int                -- T2: M-of-N agreement threshold
    challengeSecs : Int         -- T3: challenge window (0 disables T3)
    bondCC : Decimal            -- T3: proposer/challenger bond
  deriving (Eq, Show)

-- T3 optimistic-flow state, held inline on the Market while Proposed.
data ProposalInfo = ProposalInfo with
    proposer : Party
    proposedOutcome : Outcome
    proposedAt : Int            -- epoch seconds
    bondCC : Decimal
    challenger : Optional Party
    challengerOutcome : Optional Outcome
  deriving (Eq, Show)

feeFraction : Int -> Decimal
feeFraction bps = intToDecimal bps / 10000.0

-- Trading opens after the (dynamic-pool) pre-trading liquidity-collection
-- window; it is also the decay anchor for L_eff (trading start).
tradingStartsAt : PredictionMarket -> Int
tradingStartsAt m = m.createdAt + m.liquidityPeriodSecs

-- Effective (possibly time-decayed) liquidity of a market at nowSecs.
-- Before trading starts, L_eff = L0 (full liquidity during collection).
effLOf : PredictionMarket -> Int -> Decimal
effLOf m nowSecs =
  effectiveLiquidity m.isDynamic m.liquidityL (tradingStartsAt m) m.expiresAt nowSecs

-- Virtual reserves: closed-form optimal reserves for the cached price at the
-- effective liquidity. Trades always run against these virtual reserves.
virtualReservesOf : PredictionMarket -> Int -> (Decimal, Decimal)
virtualReservesOf m nowSecs = optimalReserves m.currentPrice (effLOf m nowSecs)

outcomeRealisation : Outcome -> Decimal
outcomeRealisation o = if o == Yes then 1.0 else 0.0

lookupSourceKey : [SourceKey] -> Text -> Optional Text
lookupSourceKey keys uri = case filter (\k -> k.sourceUri == uri) keys of
  (k :: _) -> Some k.publicKey
  [] -> None

-- ---------------------------------------------------------------------------
-- UserWallet: the in-app CC balance (custodial claim on the admin treasury)
-- ---------------------------------------------------------------------------

template UserWallet
  with
    admin : Party           -- treasury custodian (Enterprise Wallet party)
    owner : Party
    balanceCC : Decimal     -- spendable in-app balance
    depositedCC : Decimal   -- lifetime external deposits (reconciliation)
    withdrawnCC : Decimal   -- lifetime external withdrawals (reconciliation)
    -- txRefs already credited, newest first. Optional and LAST so 2.0.0 passes the
    -- smart-contract-upgrade check against 1.0.0 contracts, which read as None.
    depositRefs : Optional [Text]
  where
    signatory admin
    observer owner
    ensure balanceCC >= 0.0 && depositedCC >= 0.0 && withdrawnCC >= 0.0

    -- External top-up: the admin credits after receiving the owner's real CC
    -- transfer. txRef is recorded on the contract, so which transfers were credited
    -- is an on-ledger invariant rather than an off-chain derivation, and replaying a
    -- credit for the same transfer aborts here even if it slips past command-dedup.
    choice Deposit : ContractId UserWallet
      with
        amountCC : Decimal
        txRef : Text
      controller admin
      do
        assertMsg "deposit must be positive" (amountCC > 0.0)
        let credited = fromOptional [] depositRefs
        assertMsg "txRef was already credited" (notElem txRef credited)
        create this with
          balanceCC = balanceCC + amountCC
          depositedCC = depositedCC + amountCC
          depositRefs = Some (txRef :: credited)

    -- Internal credit (trade proceeds, redemptions, payout settlement).
    choice Credit : ContractId UserWallet
      with
        amountCC : Decimal
        reason : Text
      controller admin
      do
        assertMsg "credit must be positive" (amountCC > 0.0)
        create this with balanceCC = balanceCC + amountCC

    -- Internal debit. Requires BOTH the owner's and the admin's authority, so
    -- it is only reachable from inside a market choice (owner = exercising
    -- controller, admin = the market's signatory) - neither party can drain
    -- or burn a balance unilaterally.
    choice Debit : ContractId UserWallet
      with
        amountCC : Decimal
        reason : Text
      controller owner, admin
      do
        assertMsg "debit must be positive" (amountCC > 0.0)
        assertMsg "insufficient in-app balance" (balanceCC >= amountCC)
        create this with balanceCC = balanceCC - amountCC

    -- Owner moves in-app CC back to an external wallet: debits the balance
    -- and queues a PendingPayout (marketId 0 = not market-specific) for the
    -- admin to settle via the Enterprise Wallet.
    choice Withdraw : (ContractId UserWallet, ContractId PendingPayout)
      with
        amountCC : Decimal
        nowSeconds : Int
      controller owner
      do
        assertMsg "withdrawal must be positive" (amountCC > 0.0)
        assertMsg "insufficient in-app balance" (balanceCC >= amountCC)
        newCid <- create this with
          balanceCC = balanceCC - amountCC
          withdrawnCC = withdrawnCC + amountCC
        payoutCid <- create PendingPayout with
          admin, user = owner, marketId = 0
          amountCC
          reason = "withdraw"
          createdAt = nowSeconds
        return (newCid, payoutCid)

-- Fetch-validate-debit helper for market choices: charges the exercising
-- user's in-app wallet. Passes the cid through unchanged on a zero amount
-- (e.g. zero-bond policies).
debitUserWallet
  : Party -> Party -> ContractId UserWallet -> Decimal -> Text
 -> Update (ContractId UserWallet)
debitUserWallet admin owner walletCid amountCC reason =
  if amountCC <= 0.0 then return walletCid
  else do
    w <- fetch walletCid
    assertMsg "wallet belongs to a different owner" (w.owner == owner)
    assertMsg "wallet is managed by a different admin" (w.admin == admin)
    exercise walletCid Debit with amountCC, reason

-- Fetch-validate-credit helper for market choices: pays proceeds into the
-- exercising user's in-app wallet. Cid passthrough on a zero amount.
creditUserWallet
  : Party -> Party -> ContractId UserWallet -> Decimal -> Text
 -> Update (ContractId UserWallet)
creditUserWallet admin owner walletCid amountCC reason =
  if amountCC <= 0.0 then return walletCid
  else do
    w <- fetch walletCid
    assertMsg "wallet belongs to a different owner" (w.owner == owner)
    assertMsg "wallet is managed by a different admin" (w.admin == admin)
    exercise walletCid Credit with amountCC, reason

-- ---------------------------------------------------------------------------
-- Payout queue (admin owes user CC for flows that cannot debit/credit a
-- wallet inline: external withdrawals, T3 bond settlement, model prizes)
-- ---------------------------------------------------------------------------

template PendingPayout
  with
    admin : Party
    user : Party
    marketId : Int   -- 0 = not market-specific (withdrawals)
    amountCC : Decimal
    reason : Text   -- "withdraw" | "liquidity" | "bond" | "model-prize"
    createdAt : Int
  where
    signatory admin
    observer user

    -- Settled off-ledger: the admin sent real CC via the Enterprise Wallet.
    choice MarkPaid : ()
      with
        txHash : Text
      controller admin
      do return ()

    -- Settled on-ledger: credit the user's in-app wallet instead of sending
    -- external CC.
    choice SettleToWallet : ContractId UserWallet
      with
        walletCid : ContractId UserWallet
      controller admin
      do
        w <- fetch walletCid
        assertMsg "wallet belongs to a different user" (w.owner == user)
        assertMsg "wallet is managed by a different admin" (w.admin == admin)
        exercise walletCid Credit with amountCC, reason

    -- User escape hatch. For a withdrawal (or any payout), passing the
    -- user's wallet re-credits the amount to the in-app balance; None just
    -- forfeits the payout.
    choice CancelPayout : Optional (ContractId UserWallet)
      with
        refundWalletCid : Optional (ContractId UserWallet)
      controller user
      do
        case refundWalletCid of
          None -> return None
          Some wCid -> do
            w <- fetch wCid
            assertMsg "wallet belongs to a different user" (w.owner == user)
            assertMsg "wallet is managed by a different admin" (w.admin == admin)
            Some <$> exercise wCid Credit with
              amountCC
              reason = "cancel:" <> reason

-- ---------------------------------------------------------------------------
-- Position: a trader's YES/NO share holding for one market
-- ---------------------------------------------------------------------------

template Position
  with
    holder : Party
    admin : Party
    marketId : Int
    yesShares : Decimal
    noShares : Decimal
    costBasisCC : Decimal   -- lifetime CC spent on this market (void refunds / accounting)
    auditObservers : [Party]
  where
    signatory holder
    observer admin, auditObservers
    ensure yesShares >= 0.0 && noShares >= 0.0 && costBasisCC >= 0.0

-- Create-or-update helper used by market choices (controller supplies the
-- holder's authority; the market's signatory supplies the admin's).
upsertPosition
  : Party -> Party -> Int -> [Party]
 -> Decimal -> Decimal -> Decimal
 -> Optional (ContractId Position)
 -> Update (ContractId Position)
upsertPosition holder admin marketId auditObservers dYes dNo dCost optCid =
  case optCid of
    None -> create Position with
      holder, admin, marketId, auditObservers
      yesShares = dYes
      noShares = dNo
      costBasisCC = dCost
    Some cid -> do
      pos <- fetch cid
      assertMsg "position belongs to a different holder" (pos.holder == holder)
      assertMsg "position references a different market" (pos.marketId == marketId)
      archive cid
      create pos with
        yesShares = pos.yesShares + dYes
        noShares = pos.noShares + dNo
        costBasisCC = pos.costBasisCC + dCost

-- ---------------------------------------------------------------------------
-- LiquidityPosition: an LP's pro-rata claim on the pm-AMM reserve
-- ---------------------------------------------------------------------------

template LiquidityPosition
  with
    provider : Party
    admin : Party
    marketId : Int
    lpTokens : Decimal
    depositedCC : Decimal
    auditObservers : [Party]
  where
    signatory provider
    observer admin, auditObservers
    ensure lpTokens >= 0.0 && depositedCC >= 0.0

-- ---------------------------------------------------------------------------
-- OutcomeAttestation: a signed claim about what an allowlisted source reported
-- ---------------------------------------------------------------------------

template OutcomeAttestation
  with
    attester : Party            -- source desk (T1), reporter (T2), or proposer (T3)
    admin : Party
    marketId : Int
    sourceUri : Text
    fetchedAt : Int             -- epoch seconds of the reading
    outcome : Outcome
    payloadHash : Text          -- sha256 hex of the verbatim source response
    sourceSignature : Optional Text  -- T1 only: source's secp256k1 signature over payloadHash
    responseExcerpt : Optional Text
  where
    signatory attester
    observer admin

    choice ArchiveAttestation : ()
      controller admin
      do return ()

-- T1: verify the source's own signature over the payload hash on-ledger.
verifyFirstParty : Text -> OutcomeAttestation -> Bool
verifyFirstParty pinnedKey att = case att.sourceSignature of
  None -> False
  Some sig ->
    isBytesHex sig && isBytesHex att.payloadHash && isBytesHex pinnedKey
      && secp256k1 sig att.payloadHash pinnedKey

-- ---------------------------------------------------------------------------
-- Market forecast (prediction-model marketplace output; see Marketplace.daml
-- for the model registry). Creatable only while the market is Trading, via
-- the market's CommitForecast choice - ledger ordering is proof-of-priority.
-- ---------------------------------------------------------------------------

template ModelForecast
  with
    author : Party
    admin : Party
    marketId : Int
    modelId : Text
    probabilityYes : Decimal      -- q in [0, 1]
    committedAt : Int
    marketPriceAtCommit : Decimal -- pm-AMM YES price when committed (beat-the-market gate)
    auditObservers : [Party]
  where
    signatory author
    observer admin, auditObservers
    ensure probabilityYes >= 0.0 && probabilityYes <= 1.0

    choice ArchiveForecast : ()
      controller admin
      do return ()

-- ---------------------------------------------------------------------------
-- The Market: metadata + inline dynamic pm-AMM + resolution policy
-- ---------------------------------------------------------------------------

template PredictionMarket
  with
    admin : Party               -- operator & treasury (Enterprise Wallet party)
    marketId : Int
    question : Text
    imageUrl : Text
    description : Text
    resolutionDescription : Text
    category : Text
    createdAt : Int             -- epoch seconds
    expiresAt : Int             -- trading stops; resolution window opens
    gracePeriodSecs : Int       -- resolution must complete before expiresAt + grace
    isDynamic : Bool            -- L decays as sqrt((T-t)/(T-t0)) when True
    liquidityPeriodSecs : Int   -- pre-trading liquidity-collection window (0 = trade immediately)
    reserveYes : Decimal        -- physical YES inventory (custody/solvency)
    reserveNo : Decimal         -- physical NO inventory
    liquidityL : Decimal        -- L0 (base liquidity parameter)
    lpTokenSupply : Decimal
    currentPrice : Decimal      -- cached pm-AMM YES price (virtual-reserve anchor)
    feeBps : Int                -- per-trade fee, basis points, on the collateral leg
    prizeFeeShareBps : Int      -- slice of each fee routed to the model prize pool
    accumulatedFeesCC : Decimal -- LP fee pot
    prizePoolCC : Decimal       -- model-marketplace prize pot
    totalVolumeCC : Decimal
    status : MarketStatus
    outcome : Optional Outcome
    resolvedAt : Optional Int
    proposal : Optional ProposalInfo
    policy : ResolutionPolicy
    auditObservers : [Party]
  where
    signatory admin
    observer auditObservers, policy.reporters
    ensure reserveYes >= 0.0 && reserveNo >= 0.0 && lpTokenSupply >= 0.0
      && currentPrice > 0.0 && currentPrice < 1.0
      && feeBps >= 0 && feeBps <= 1000 && expiresAt > createdAt

    -- -----------------------------------------------------------------
    -- Trading surface
    -- -----------------------------------------------------------------

    -- Buy outcome shares with collateral debited from the buyer's in-app
    -- wallet - a single wallet action, atomic with the share mint. Net
    -- collateral mints complete sets whose opposite leg is swapped into the
    -- pool; the buyer receives collateral/P-ish shares subject to price impact.
    choice Buy : (ContractId PredictionMarket, ContractId Position, ContractId UserWallet)
      with
        buyer : Party
        side : Outcome
        collateralCC : Decimal
        minSharesOut : Decimal
        nowSeconds : Int
        existingPosition : Optional (ContractId Position)
        walletCid : ContractId UserWallet
      controller buyer
      do
        assertMsg "market is not trading" (status == Trading)
        assertMsg "trading has not started (liquidity period)" (nowSeconds >= tradingStartsAt this)
        assertMsg "market has expired" (nowSeconds < expiresAt)
        assertMsg "side must be Yes or No" (side /= VoidOutcome)
        assertMsg "collateral must be positive" (collateralCC > 0.0)

        newWalletCid <- debitUserWallet admin buyer walletCid collateralCC "buy"

        let l = effLOf this nowSeconds
        assertMsg "no effective liquidity" (l > 0.0)
        let (xv, yv) = virtualReservesOf this nowSeconds
            fee = collateralCC * feeFraction feeBps
            prizeCut = fee * feeFraction prizeFeeShareBps
            net = collateralCC - fee
            -- Solver works on YES-orientation; mirror reserves for NO
            -- (the invariant is symmetric under x <-> y).
            sharesOut = if side == Yes
              then solveBuyShares xv yv l net
              else solveBuyShares yv xv l net
        assertMsg "slippage: fewer shares than minSharesOut" (sharesOut >= minSharesOut)
        assertMsg "trade too large for pool" (sharesOut > 0.0)

        let diff = yv - xv
            newDiff = if side == Yes then diff + sharesOut else diff - sharesOut
            newPrice = clampProb (normCdf (newDiff / l))
            newPhysYes = if side == Yes then reserveYes + net - sharesOut else reserveYes + net
            newPhysNo  = if side == Yes then reserveNo + net else reserveNo + net - sharesOut
        assertMsg "insufficient pool inventory" (newPhysYes >= 0.0 && newPhysNo >= 0.0)

        posCid <- upsertPosition buyer admin marketId auditObservers
          (if side == Yes then sharesOut else 0.0)
          (if side == No then sharesOut else 0.0)
          collateralCC
          existingPosition

        marketCid <- create this with
          reserveYes = newPhysYes
          reserveNo = newPhysNo
          currentPrice = newPrice
          accumulatedFeesCC = accumulatedFeesCC + fee - prizeCut
          prizePoolCC = prizePoolCC + prizeCut
          totalVolumeCC = totalVolumeCC + collateralCC

        return (marketCid, posCid, newWalletCid)

    -- Sell outcome shares back to the pm-AMM for collateral (closed form).
    -- Burns shares, credits the net proceeds to the seller's in-app wallet -
    -- immediately spendable, no payout batching.
    choice Sell : (ContractId PredictionMarket, ContractId Position, ContractId UserWallet)
      with
        seller : Party
        side : Outcome
        sharesIn : Decimal
        minProceedsCC : Decimal
        nowSeconds : Int
        positionCid : ContractId Position
        walletCid : ContractId UserWallet
      controller seller
      do
        assertMsg "market is not trading" (status == Trading)
        assertMsg "trading has not started (liquidity period)" (nowSeconds >= tradingStartsAt this)
        assertMsg "market has expired" (nowSeconds < expiresAt)
        assertMsg "side must be Yes or No" (side /= VoidOutcome)
        assertMsg "shares must be positive" (sharesIn > 0.0)

        pos <- fetch positionCid
        assertMsg "position belongs to a different holder" (pos.holder == seller)
        assertMsg "position references a different market" (pos.marketId == marketId)
        assertMsg "insufficient shares"
          (if side == Yes then pos.yesShares >= sharesIn else pos.noShares >= sharesIn)

        let l = effLOf this nowSeconds
        assertMsg "no effective liquidity" (l > 0.0)
        let (xv, yv) = virtualReservesOf this nowSeconds
            gross = if side == Yes
              then solveSellProceeds xv yv l sharesIn
              else solveSellProceeds yv xv l sharesIn
            fee = gross * feeFraction feeBps
            prizeCut = fee * feeFraction prizeFeeShareBps
            net = gross - fee
        assertMsg "slippage: proceeds below minProceedsCC" (net >= minProceedsCC)
        assertMsg "trade too large for pool" (gross > 0.0)

        let diff = yv - xv
            newDiff = if side == Yes then diff - sharesIn else diff + sharesIn
            newPrice = clampProb (normCdf (newDiff / l))
            newPhysYes = if side == Yes then reserveYes + sharesIn - gross else reserveYes - gross
            newPhysNo  = if side == Yes then reserveNo - gross else reserveNo + sharesIn - gross
        assertMsg "insufficient pool inventory" (newPhysYes >= 0.0 && newPhysNo >= 0.0)

        archive positionCid
        newPosCid <- create pos with
          yesShares = if side == Yes then pos.yesShares - sharesIn else pos.yesShares
          noShares = if side == No then pos.noShares - sharesIn else pos.noShares

        newWalletCid <- creditUserWallet admin seller walletCid net "sell"

        marketCid <- create this with
          reserveYes = newPhysYes
          reserveNo = newPhysNo
          currentPrice = newPrice
          accumulatedFeesCC = accumulatedFeesCC + fee - prizeCut
          prizePoolCC = prizePoolCC + prizeCut
          totalVolumeCC = totalVolumeCC + gross

        return (marketCid, newPosCid, newWalletCid)

    -- Direct outcome-token swap (the pm-AMM's primitive trading operation):
    -- deposit shares of one side, receive shares of the other. The fee is
    -- taken from the input shares and retained in the pool's physical
    -- reserves (accruing to LPs at settlement, like a fee vault).
    choice SwapShares : (ContractId PredictionMarket, ContractId Position)
      with
        swapper : Party
        fromSide : Outcome
        sharesIn : Decimal
        minSharesOut : Decimal
        nowSeconds : Int
        positionCid : ContractId Position
      controller swapper
      do
        assertMsg "market is not trading" (status == Trading)
        assertMsg "trading has not started (liquidity period)" (nowSeconds >= tradingStartsAt this)
        assertMsg "market has expired" (nowSeconds < expiresAt)
        assertMsg "fromSide must be Yes or No" (fromSide /= VoidOutcome)
        assertMsg "shares must be positive" (sharesIn > 0.0)

        pos <- fetch positionCid
        assertMsg "position belongs to a different holder" (pos.holder == swapper)
        assertMsg "position references a different market" (pos.marketId == marketId)
        assertMsg "insufficient shares"
          (if fromSide == Yes then pos.yesShares >= sharesIn else pos.noShares >= sharesIn)

        let l = effLOf this nowSeconds
        assertMsg "no effective liquidity" (l > 0.0)
        let (xv, yv) = virtualReservesOf this nowSeconds
            feeShares = sharesIn * feeFraction feeBps
            net = sharesIn - feeShares
            -- solveSwapOut deposits into the x-orientation side; mirror for NO->YES.
            sharesOut = if fromSide == Yes
              then solveSwapOut xv yv l net
              else solveSwapOut yv xv l net
        assertMsg "slippage: fewer shares than minSharesOut" (sharesOut >= minSharesOut)
        assertMsg "trade too large for pool" (sharesOut > 0.0)

        let diff = yv - xv
            -- YES in / NO out: diff' = (yv - out) - (xv + net); mirror otherwise.
            newDiff = if fromSide == Yes then diff - sharesOut - net else diff + sharesOut + net
            newPrice = clampProb (normCdf (newDiff / l))
            fromPrice = if fromSide == Yes then currentPrice else 1.0 - currentPrice
            newPhysYes = if fromSide == Yes then reserveYes + sharesIn else reserveYes - sharesOut
            newPhysNo  = if fromSide == Yes then reserveNo - sharesOut else reserveNo + sharesIn
        assertMsg "insufficient pool inventory" (newPhysYes >= 0.0 && newPhysNo >= 0.0)

        archive positionCid
        newPosCid <- create pos with
          yesShares = if fromSide == Yes then pos.yesShares - sharesIn else pos.yesShares + sharesOut
          noShares = if fromSide == Yes then pos.noShares + sharesOut else pos.noShares - sharesIn

        marketCid <- create this with
          reserveYes = newPhysYes
          reserveNo = newPhysNo
          currentPrice = newPrice
          totalVolumeCC = totalVolumeCC + sharesIn * fromPrice

        return (marketCid, newPosCid)

    -- Mint complete sets: 1 CC -> 1 YES + 1 NO (no-arbitrage invariant).
    -- The CC is debited from the user's in-app wallet atomically.
    nonconsuming choice Split : (ContractId Position, ContractId UserWallet)
      with
        user : Party
        amount : Decimal
        nowSeconds : Int
        existingPosition : Optional (ContractId Position)
        walletCid : ContractId UserWallet
      controller user
      do
        assertMsg "market is not trading" (status == Trading)
        assertMsg "market has expired" (nowSeconds < expiresAt)
        assertMsg "amount must be positive" (amount > 0.0)
        newWalletCid <- debitUserWallet admin user walletCid amount "split"
        posCid <- upsertPosition user admin marketId auditObservers amount amount amount existingPosition
        return (posCid, newWalletCid)

    -- Burn equal YES+NO pairs for 1 CC each, credited to the in-app wallet.
    nonconsuming choice Merge : (ContractId Position, ContractId UserWallet)
      with
        user : Party
        amount : Decimal
        nowSeconds : Int
        positionCid : ContractId Position
        walletCid : ContractId UserWallet
      controller user
      do
        assertMsg "amount must be positive" (amount > 0.0)
        pos <- fetch positionCid
        assertMsg "position belongs to a different holder" (pos.holder == user)
        assertMsg "position references a different market" (pos.marketId == marketId)
        assertMsg "insufficient pairs" (pos.yesShares >= amount && pos.noShares >= amount)
        archive positionCid
        newPosCid <- create pos with
          yesShares = pos.yesShares - amount
          noShares = pos.noShares - amount
        newWalletCid <- creditUserWallet admin user walletCid amount "merge"
        return (newPosCid, newWalletCid)

    -- -----------------------------------------------------------------
    -- Liquidity provision (value-based, price-preserving)
    -- -----------------------------------------------------------------

    -- LP names a desired pool-value increase dV; the pool scales x, y and L
    -- by (V + dV)/V so the price is untouched. Cost in CC = max(dx, dy)
    -- (collateral that fully backs the minted inventory), debited from the
    -- provider's in-app wallet; maxCostCC bounds quote drift.
    choice ProvideLiquidity : (ContractId PredictionMarket, ContractId LiquidityPosition, ContractId UserWallet)
      with
        provider : Party
        valueIncreaseCC : Decimal
        maxCostCC : Decimal
        nowSeconds : Int
        existingLpPosition : Optional (ContractId LiquidityPosition)
        walletCid : ContractId UserWallet
      controller provider
      do
        assertMsg "market is not trading" (status == Trading)
        assertMsg "market has expired" (nowSeconds < expiresAt)
        assertMsg "value increase must be positive" (valueIncreaseCC > 0.0)

        let l = effLOf this nowSeconds
        assertMsg "no effective liquidity" (l > 0.0)
        let v = poolValue currentPrice l
            ratio = valueIncreaseCC / v
            (xv, yv) = virtualReservesOf this nowSeconds
            dX = xv * ratio
            dY = yv * ratio
            costCC = max dX dY
            lpMinted = lpTokenSupply * ratio
        assertMsg "cost exceeds maxCostCC" (costCC <= maxCostCC)

        newWalletCid <- debitUserWallet admin provider walletCid costCC "liquidity-provide"

        lpCid <- case existingLpPosition of
          None -> create LiquidityPosition with
            provider, admin, marketId, auditObservers
            lpTokens = lpMinted
            depositedCC = costCC
          Some cid -> do
            lp <- fetch cid
            assertMsg "lp position belongs to a different provider" (lp.provider == provider)
            assertMsg "lp position references a different market" (lp.marketId == marketId)
            archive cid
            create lp with
              lpTokens = lp.lpTokens + lpMinted
              depositedCC = lp.depositedCC + costCC

        marketCid <- create this with
          reserveYes = reserveYes + dX
          reserveNo = reserveNo + dY
          liquidityL = liquidityL * (1.0 + ratio)
          lpTokenSupply = lpTokenSupply + lpMinted

        return (marketCid, lpCid, newWalletCid)

    -- Withdraw liquidity. Dynamic pools lock LPs until resolution/void
    -- (uniform-LVR design); static pools may exit early receiving shares.
    -- CC proceeds are credited to the provider's in-app wallet.
    choice WithdrawLiquidity : (ContractId PredictionMarket, Optional (ContractId LiquidityPosition), ContractId UserWallet)
      with
        provider : Party
        lpTokensToBurn : Decimal
        nowSeconds : Int
        lpPositionCid : ContractId LiquidityPosition
        existingPosition : Optional (ContractId Position)  -- for early static exits (shares out)
        walletCid : ContractId UserWallet
      controller provider
      do
        assertMsg "burn amount must be positive" (lpTokensToBurn > 0.0)
        lp <- fetch lpPositionCid
        assertMsg "lp position belongs to a different provider" (lp.provider == provider)
        assertMsg "lp position references a different market" (lp.marketId == marketId)
        assertMsg "insufficient LP tokens" (lp.lpTokens >= lpTokensToBurn)
        assertMsg "empty pool" (lpTokenSupply > 0.0)

        let share = lpTokensToBurn / lpTokenSupply
            feeOut = accumulatedFeesCC * share
            remainingLp = lp.lpTokens - lpTokensToBurn
            refundBasis = lp.depositedCC * (lpTokensToBurn / lp.lpTokens)

        newLpCid <- do
          archive lpPositionCid
          if remainingLp > 0.0
            then Some <$> create lp with
                   lpTokens = remainingLp
                   depositedCC = lp.depositedCC - refundBasis
            else return None

        case status of
          Resolved -> do
            let winning = case outcome of
                  Some Yes -> reserveYes
                  Some No -> reserveNo
                  _ -> 0.0
                payout = winning * share + feeOut
            newWalletCid <- creditUserWallet admin provider walletCid payout "liquidity"
            marketCid <- create this with
              reserveYes = reserveYes * (1.0 - share)
              reserveNo = reserveNo * (1.0 - share)
              accumulatedFeesCC = accumulatedFeesCC - feeOut
              lpTokenSupply = lpTokenSupply - lpTokensToBurn
            return (marketCid, newLpCid, newWalletCid)
          Voided -> do
            newWalletCid <- creditUserWallet admin provider walletCid (refundBasis + feeOut) "liquidity"
            marketCid <- create this with
              reserveYes = reserveYes * (1.0 - share)
              reserveNo = reserveNo * (1.0 - share)
              accumulatedFeesCC = accumulatedFeesCC - feeOut
              lpTokenSupply = lpTokenSupply - lpTokensToBurn
            return (marketCid, newLpCid, newWalletCid)
          Trading -> do
            assertMsg "dynamic-pool LP is locked until resolution" (not isDynamic)
            -- Early static exit: proportional physical inventory into the
            -- provider's Position, fee share as CC.
            let sharesYesOut = reserveYes * share
                sharesNoOut = reserveNo * share
            _ <- upsertPosition provider admin marketId auditObservers
                   sharesYesOut sharesNoOut 0.0 existingPosition
            newWalletCid <- creditUserWallet admin provider walletCid feeOut "liquidity"
            marketCid <- create this with
              reserveYes = reserveYes - sharesYesOut
              reserveNo = reserveNo - sharesNoOut
              liquidityL = liquidityL * (1.0 - share)
              accumulatedFeesCC = accumulatedFeesCC - feeOut
              lpTokenSupply = lpTokenSupply - lpTokensToBurn
            return (marketCid, newLpCid, newWalletCid)
          Proposed -> abort "cannot withdraw while a proposal is pending"

    -- -----------------------------------------------------------------
    -- Resolution (tiers T0-T3) and voiding
    -- -----------------------------------------------------------------

    -- T0: the designated operator records the result directly (Kalshi model).
    choice ResolveT0 : ContractId PredictionMarket
      with
        resolvedOutcome : Outcome
        sourceUri : Text
        nowSeconds : Int
      controller admin
      do
        assertMsg "T0 operator resolution not enabled" policy.operatorResolution
        assertMsg "market is not awaiting resolution" (status == Trading)
        assertMsg "market not yet expired" (nowSeconds >= expiresAt)
        assertMsg "resolution window elapsed" (nowSeconds <= expiresAt + gracePeriodSecs)
        assertMsg "source not in allowlist" (sourceUri `elem` policy.sources || null policy.sources)
        create this with
          status = if resolvedOutcome == VoidOutcome then Voided else Resolved
          outcome = Some resolvedOutcome
          resolvedAt = Some nowSeconds

    -- T1/T2: resolve from gathered attestations. Accepts iff a first-party
    -- signature verifies (T1) OR a reporter quorum agrees (T2). Also the
    -- objective escalation target for a challenged T3 proposal: bonds are
    -- settled here (loser slashed to winner).
    choice Resolve : ContractId PredictionMarket
      with
        attestationCids : [ContractId OutcomeAttestation]
        nowSeconds : Int
      controller admin
      do
        assertMsg "market is not awaiting resolution" (status == Trading || status == Proposed)
        assertMsg "market not yet expired" (nowSeconds >= expiresAt)
        assertMsg "no attestations supplied" (not (null attestationCids))
        atts <- mapA fetch attestationCids
        assertMsg "attestation references a different market"
          (all (\a -> a.marketId == marketId) atts)
        assertMsg "source not in allowlist"
          (all (\a -> a.sourceUri `elem` policy.sources) atts)
        let windowEnd = expiresAt + gracePeriodSecs
        assertMsg "attestation outside resolution window"
          (all (\a -> a.fetchedAt >= expiresAt && a.fetchedAt <= windowEnd) atts)

        -- T1: a single first-party signed attestation suffices.
        let firstParty = any
              (\a -> case lookupSourceKey policy.sourceKeys a.sourceUri of
                       Some k -> verifyFirstParty k a
                       None -> False) atts
        -- T2: M distinct allowlisted reporters agreeing on one outcome.
        let reporterAtts = filter (\a -> a.attester `elem` policy.reporters) atts
            signers = dedup (map (\a -> a.attester) reporterAtts)
            outcomes = dedup (map (\a -> a.outcome) reporterAtts)
            quorumMet = policy.quorum > 0
              && length signers >= policy.quorum
              && length outcomes == 1
        assertMsg "no resolution tier satisfied" (firstParty || quorumMet)

        let resolved = (\a -> a.outcome) (head atts)
        assertMsg "attestations disagree" (all (\a -> a.outcome == resolved) atts)

        settleBonds admin marketId proposal resolved nowSeconds

        create this with
          status = if resolved == VoidOutcome then Voided else Resolved
          outcome = Some resolved
          resolvedAt = Some nowSeconds
          proposal = None

    -- T3: bonded optimistic proposal (Polymarket UX). The bond is debited
    -- from the proposer's in-app wallet atomically.
    choice ProposeOutcome : (ContractId PredictionMarket, ContractId UserWallet)
      with
        proposer : Party
        proposedOutcome : Outcome
        nowSeconds : Int
        walletCid : ContractId UserWallet
      controller proposer
      do
        assertMsg "T3 optimistic flow not enabled" (policy.challengeSecs > 0)
        assertMsg "market is not awaiting a proposal" (status == Trading)
        assertMsg "market not yet expired" (nowSeconds >= expiresAt)
        assertMsg "resolution window elapsed" (nowSeconds <= expiresAt + gracePeriodSecs)
        newWalletCid <- debitUserWallet admin proposer walletCid policy.bondCC "bond"
        marketCid <- create this with
          status = Proposed
          proposal = Some ProposalInfo with
            proposer
            proposedOutcome
            proposedAt = nowSeconds
            bondCC = policy.bondCC
            challenger = None
            challengerOutcome = None
        return (marketCid, newWalletCid)

    -- T3: bonded challenge. Does NOT trigger a vote - it escalates to the
    -- authoritative tier (Resolve with T1/T2 attestations). The bond is
    -- debited from the challenger's in-app wallet atomically.
    choice ChallengeOutcome : (ContractId PredictionMarket, ContractId UserWallet)
      with
        challenger : Party
        challengerOutcome : Outcome
        nowSeconds : Int
        walletCid : ContractId UserWallet
      controller challenger
      do
        assertMsg "no proposal to challenge" (status == Proposed)
        case proposal of
          None -> abort "no proposal state"
          Some p -> do
            assertMsg "proposal already challenged" (isNone p.challenger)
            assertMsg "challenge window elapsed"
              (nowSeconds <= p.proposedAt + policy.challengeSecs)
            assertMsg "challenge must assert a different outcome"
              (challengerOutcome /= p.proposedOutcome)
            newWalletCid <- debitUserWallet admin challenger walletCid p.bondCC "bond"
            marketCid <- create this with
              proposal = Some p with
                challenger = Some challenger
                challengerOutcome = Some challengerOutcome
            return (marketCid, newWalletCid)

    -- T3: an unchallenged proposal finalizes after the window; the proposer's
    -- bond is returned.
    choice FinalizeOutcome : ContractId PredictionMarket
      with
        finalizer : Party
        nowSeconds : Int
      controller finalizer
      do
        assertMsg "no proposal to finalize" (status == Proposed)
        case proposal of
          None -> abort "no proposal state"
          Some p -> do
            assertMsg "proposal was challenged - escalate via Resolve" (isNone p.challenger)
            assertMsg "challenge window still open"
              (nowSeconds > p.proposedAt + policy.challengeSecs)
            when (p.bondCC > 0.0) $ do
              _ <- create PendingPayout with
                admin, user = p.proposer, marketId
                amountCC = p.bondCC
                reason = "bond"
                createdAt = nowSeconds
              return ()
            create this with
              status = if p.proposedOutcome == VoidOutcome then Voided else Resolved
              outcome = Some p.proposedOutcome
              resolvedAt = Some nowSeconds
              proposal = None

    -- No tier produced a valid resolution within the grace period.
    choice VoidMarket : ContractId PredictionMarket
      with
        nowSeconds : Int
      controller admin
      do
        assertMsg "market already settled" (status == Trading || status == Proposed)
        assertMsg "grace period not yet elapsed" (nowSeconds > expiresAt + gracePeriodSecs)
        settleBonds admin marketId proposal VoidOutcome nowSeconds
        create this with
          status = Voided
          outcome = Some VoidOutcome
          resolvedAt = Some nowSeconds
          proposal = None

    -- -----------------------------------------------------------------
    -- Redemption
    -- -----------------------------------------------------------------

    -- After Resolved: 1 CC per winning share, 0 per losing share.
    -- After Voided: cost basis refunded. Archives the position; the payout
    -- is credited to the holder's in-app wallet.
    nonconsuming choice RedeemPosition : ContractId UserWallet
      with
        holder : Party
        nowSeconds : Int
        positionCid : ContractId Position
        walletCid : ContractId UserWallet
      controller holder
      do
        assertMsg "market not settled" (status == Resolved || status == Voided)
        pos <- fetch positionCid
        assertMsg "position belongs to a different holder" (pos.holder == holder)
        assertMsg "position references a different market" (pos.marketId == marketId)
        let payout = case (status, outcome) of
              (Resolved, Some Yes) -> pos.yesShares
              (Resolved, Some No) -> pos.noShares
              -- Void refunds the cost basis, bounded by the shares still
              -- held (earlier sells/merges were already paid out).
              (Voided, _) -> min pos.costBasisCC (max pos.yesShares pos.noShares)
              _ -> 0.0
        assertMsg "nothing to redeem" (payout > 0.0)
        archive positionCid
        creditUserWallet admin holder walletCid payout
          (if status == Voided then "void-refund" else "resolve")

    -- -----------------------------------------------------------------
    -- Prediction-model marketplace hooks
    -- -----------------------------------------------------------------

    -- Commit a timestamped forecast while the market is Trading. Ledger
    -- ordering makes the timestamp unforgeable proof-of-priority.
    nonconsuming choice CommitForecast : ContractId ModelForecast
      with
        author : Party
        modelId : Text
        probabilityYes : Decimal
        nowSeconds : Int
      controller author
      do
        assertMsg "market is not trading" (status == Trading)
        assertMsg "market has expired" (nowSeconds < expiresAt)
        assertMsg "probability must be within (0, 1)"
          (probabilityYes > 0.0 && probabilityYes < 1.0)
        create ModelForecast with
          author, admin, marketId, modelId, probabilityYes, auditObservers
          committedAt = nowSeconds
          marketPriceAtCommit = currentPrice

    -- Score committed forecasts against the realised outcome (Brier score,
    -- s = (q - o)^2; weight w = 1 - s) and distribute the fee-funded prize
    -- pool pro-rata. Only forecasts that beat the pm-AMM price at their
    -- commit time are paid. Deterministic and reproducible by audit observers.
    choice ScoreAndDistribute : ContractId PredictionMarket
      with
        forecastCids : [ContractId ModelForecast]
        nowSeconds : Int
      controller admin
      do
        assertMsg "market not resolved" (status == Resolved)
        let o = outcomeRealisation (fromOptional Yes outcome)
        assertMsg "voided markets are not scored" (outcome /= Some VoidOutcome)
        forecasts <- mapA fetch forecastCids
        assertMsg "forecast references a different market"
          (all (\f -> f.marketId == marketId) forecasts)
        let beatMarket f = abs (f.probabilityYes - o) < abs (f.marketPriceAtCommit - o)
            eligible = filter beatMarket forecasts
            weight f = 1.0 - (f.probabilityYes - o) * (f.probabilityYes - o)
            totalW = sum (map weight eligible)
        if totalW <= 0.0 || prizePoolCC <= 0.0
          then create this  -- nothing to distribute; keep the pool
          else do
            _ <- mapA (\f -> create PendingPayout with
                   admin, user = f.author, marketId
                   amountCC = prizePoolCC * weight f / totalW
                   reason = "model-prize"
                   createdAt = nowSeconds) eligible
            create this with prizePoolCC = 0.0

    choice ArchiveMarket : ()
      controller admin
      do return ()

-- Bond settlement for a challenged/voided T3 proposal: the party whose
-- outcome matches the authoritative result receives both bonds; on Void or
-- no-match, both bonds are refunded.
settleBonds : Party -> Int -> Optional ProposalInfo -> Outcome -> Int -> Update ()
settleBonds admin marketId optProposal resolved nowSeconds =
  case optProposal of
    None -> return ()
    Some p | p.bondCC <= 0.0 -> return ()
    Some p ->
      case (p.challenger, p.challengerOutcome) of
        (Some ch, Some chOut)
          | p.proposedOutcome == resolved && chOut /= resolved -> do
              _ <- create PendingPayout with
                admin, user = p.proposer, marketId
                amountCC = p.bondCC * 2.0
                reason = "bond"
                createdAt = nowSeconds
              return ()
          | chOut == resolved && p.proposedOutcome /= resolved -> do
              _ <- create PendingPayout with
                admin, user = ch, marketId
                amountCC = p.bondCC * 2.0
                reason = "bond"
                createdAt = nowSeconds
              return ()
          | otherwise -> do
              _ <- create PendingPayout with
                admin, user = p.proposer, marketId
                amountCC = p.bondCC
                reason = "bond"
                createdAt = nowSeconds
              _ <- create PendingPayout with
                admin, user = ch, marketId
                amountCC = p.bondCC
                reason = "bond"
                createdAt = nowSeconds
              return ()
        _ -> do
          -- Unchallenged proposal superseded by authoritative resolution or
          -- void: refund the proposer's bond.
          _ <- create PendingPayout with
            admin, user = p.proposer, marketId
            amountCC = p.bondCC
            reason = "bond"
            createdAt = nowSeconds
          return ()

-- ---------------------------------------------------------------------------
-- Market counter & factory (single global instance, admin-only)
-- ---------------------------------------------------------------------------

template MarketCounter
  with
    admin : Party
    value : Int
  where
    signatory admin

    choice IncrementCounter : (ContractId MarketCounter, Int)
      controller admin
      do
        let newValue = value + 1
        newCid <- create this with value = newValue
        return (newCid, newValue)

    -- Creates a Market seeded at initialProbability with pool value
    -- initialValueCC: L0 = V / pdf(icdf P); reserves are the closed-form
    -- optimal (x*, y*). The admin's collateral cost is max(x*, y*) CC
    -- (transferred off-ledger), seeding the admin's LiquidityPosition.
    choice CreateMarket : (ContractId MarketCounter, ContractId PredictionMarket, ContractId LiquidityPosition)
      with
        question : Text
        imageUrl : Text
        description : Text
        resolutionDescription : Text
        category : Text
        createdAt : Int
        expiresAt : Int
        gracePeriodSecs : Int
        isDynamic : Bool
        liquidityPeriodSecs : Int
        initialProbability : Decimal
        initialValueCC : Decimal
        feeBps : Int
        prizeFeeShareBps : Int
        policy : ResolutionPolicy
        auditObservers : [Party]
      controller admin
      do
        assertMsg "probability must be within [0.01, 0.99]"
          (initialProbability >= 0.01 && initialProbability <= 0.99)
        assertMsg "initial pool value must be positive" (initialValueCC > 0.0)
        assertMsg "expiry must be after creation" (expiresAt > createdAt)
        assertMsg "liquidity period must be non-negative" (liquidityPeriodSecs >= 0)
        assertMsg "expiry must be after the liquidity period"
          (expiresAt > createdAt + liquidityPeriodSecs)
        assertMsg "fee must be 0..1000 bps" (feeBps >= 0 && feeBps <= 1000)
        assertMsg "prize share must be 0..10000 bps"
          (prizeFeeShareBps >= 0 && prizeFeeShareBps <= 10000)
        assertMsg "T2 quorum cannot exceed reporter count"
          (policy.quorum <= length policy.reporters)

        let newValue = value + 1
            marketId = newValue
            l0 = liquidityFromValue initialValueCC initialProbability
            (x0, y0) = optimalReserves initialProbability l0

        newCounterCid <- create this with value = newValue
        marketCid <- create PredictionMarket with
          admin, marketId, question, imageUrl, description, resolutionDescription
          category, createdAt, expiresAt, gracePeriodSecs, isDynamic, liquidityPeriodSecs
          reserveYes = x0
          reserveNo = y0
          liquidityL = l0
          lpTokenSupply = l0
          currentPrice = initialProbability
          feeBps, prizeFeeShareBps
          accumulatedFeesCC = 0.0
          prizePoolCC = 0.0
          totalVolumeCC = 0.0
          status = Trading
          outcome = None
          resolvedAt = None
          proposal = None
          policy, auditObservers
        lpCid <- create LiquidityPosition with
          provider = admin, admin, marketId, auditObservers
          lpTokens = l0
          depositedCC = max x0 y0
        return (newCounterCid, marketCid, lpCid)
