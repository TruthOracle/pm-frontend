# ============================================================================
# C8 Enterprise Wallet — DevNet config
# Copy to `.env`, fill in WALLET_MNEMONIC, then run docker compose up.
# ============================================================================

# 24-word BIP39 mnemonic. Generate with `node generate-mnemonic.mjs` in this
# directory. KEEP THIS SECRET — losing it = losing access to the wallet party.
WALLET_MNEMONIC=

# Tenant id on the Cantor8 backend. Confirmed with the C8 team: truthoracle.
CLIENT_ID=truthoracle

# Selects the network: devnet | mainnet. The wallet resolves the validator +
# scanner URLs from this alone.
WALLET_NETWORK=devnet

# DevNet identity service (also serves account recovery, /accounts/recovery_v3).
# For mainnet: https://id.cantor8.tech
IDENTITY_SERVICE_URL=https://id.dev.digik.cantor8.tech

# Auth: keycloak = every wallet API endpoint requires a Bearer JWT from the IdP
# below (JWKS signature + audience validated). Env names confirmed from the
# image's application.conf:
#   AUTH_TYPE = auth0 | keycloak | custom | noop   (noop = APIs fully open — never expose publicly)
#   keycloak: IDP_BASE_URL + AUTH_REALM  (JWKS = {IDP_BASE_URL}/realms/{AUTH_REALM}/protocol/openid-connect/certs)
#   custom:   JWKS_URL instead of IDP_BASE_URL/AUTH_REALM
# AUTH_AUDIENCE must be one of the values in the token's `aud` claim.
# For mainnet: IDP_BASE_URL=https://auth.main.digik.cantor8.tech (per C8 team).
AUTH_TYPE=keycloak
IDP_BASE_URL=https://auth.dev.digik.cantor8.tech
AUTH_REALM=master
AUTH_AUDIENCE=https://ledger_api.validator.dev.digik.cantor8.tech
AUTH_ALGOS=RS256,Ed25519

# Auto-batching off; in-memory keeps deployment simple (no Postgres dep).
AUTO_BATCH_SWITCH=false
AUTO_BATCH_DB_TYPE=in-memory

# ----------------------------------------------------------------------------
# Optional: CloudWatch logging. Leave blank unless C8 provided AWS creds.
# Forwarded via docker-compose-client.yml environment: block.
# ----------------------------------------------------------------------------
# AWS_REGION=eu-west-1
# CLOUDWATCH_LOG_GROUP=enterprise-wallet
# CLOUDWATCH_LOG_STREAM=truthoracle
# CLOUDWATCH_ENDPOINT=https://logs.eu-west-1.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
