# ============================================================================
# C8 Enterprise Wallet — DevNet config
# Copy to `.env`, fill in WALLET_MNEMONIC, then run docker compose up.
# ============================================================================

# 24-word BIP39 mnemonic. Generate with `node generate-mnemonic.mjs` in this
# directory. KEEP THIS SECRET — losing it = losing access to the wallet party.
WALLET_MNEMONIC=

# Tenant id on the Cantor8 backend. Confirmed with the C8 team: truthoracle.
CLIENT_ID=truthoracle

# DevNet endpoints (per C8 team message). For mainnet swap to .main.digik.cantor8.tech
BACKEND_URL=https://wallet-backend.dev.digik.cantor8.tech/api
IDENTITY_SERVICE_URL=https://id.dev.digik.cantor8.tech

# Auth: noop = no auth on wallet API (acceptable on a private host).
# Switch to keycloak/auth0 + provide IdP envs (from C8) for production.
AUTH_TYPE=noop

# Auto-batching off; in-memory keeps deployment simple (no Postgres dep).
AUTO_BATCH_SWITCH=false
AUTO_BATCH_DB_TYPE=in-memory

# ----------------------------------------------------------------------------
# Optional: CloudWatch logging. Leave blank unless C8 provided AWS creds.
# Forwarded via docker-compose-client.yml environment: block.
# ----------------------------------------------------------------------------
# AWS_REGION=eu-west-1
# CLOUDWATCH_LOG_GROUP=enterprise-wallet
# CLOUDWATCH_LOG_STREAM=truthoracle
# CLOUDWATCH_ENDPOINT=https://logs.eu-west-1.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
