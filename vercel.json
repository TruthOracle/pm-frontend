{
  "rewrites": [
    {
      "source": "/__proxy/keycloak/:path*",
      "destination": "/api/proxy/keycloak?path=:path*"
    },
    {
      "source": "/__proxy/ledger/:path*",
      "destination": "/api/proxy/ledger?path=:path*"
    },
    {
      "source": "/__proxy/wallet/:path*",
      "destination": "/api/proxy/wallet?path=:path*"
    },
    {
      "source": "/__proxy/c8b/:path*",
      "destination": "/api/proxy/c8backend?path=:path*"
    },
    {
      "source": "/((?!api/|__proxy/|_vercel/|.*\\.).*)",
      "destination": "/"
    }
  ]
}
