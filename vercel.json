{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__proxy/ledger/:path*",
      "destination": "/api/proxy/ledger?path=:path*"
    },
    {
      "source": "/__proxy/c8b/:path*",
      "destination": "/api/proxy/c8backend?path=:path*"
    },
    {
      "source": "/__backend/:path*",
      "destination": "/api/proxy/backend?path=:path*"
    },
    {
      "source": "/((?!api/|__proxy/|__backend/|_vercel/|.*\\.).*)",
      "destination": "/"
    }
  ]
}
