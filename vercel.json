{
  "rewrites": [
    {
      "source": "/__proxy/keycloak/:path*",
      "destination": "/api/proxy/keycloak/:path*"
    },
    {
      "source": "/__proxy/ledger/:path*",
      "destination": "/api/proxy/ledger/:path*"
    },
    {
      "source": "/((?!api/|__proxy/|_vercel/|.*\\.).*)",
      "destination": "/"
    }
  ]
}
