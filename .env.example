# TruthOracle — copy to `.env` and fill in placeholders (especially Keycloak secrets
# and VITE_ENTERPRISE_WALLET_PARTY_ID).
#
# Required for `npm run dev` + `npm run create:contract`:
#   VITE_TRUTHORACLE_PACKAGE_ID, VITE_CANTON_PARTICIPANT_URL,
#   VITE_KEYCLOAK_URL, VITE_KEYCLOAK_REALM, VITE_KEYCLOAK_CLIENT_ID, VITE_KEYCLOAK_CLIENT_SECRET,
#   VITE_ENTERPRISE_WALLET_PARTY_ID  ← admin party; UI marketplace + admin gating require it.
#
# =============================================================================
# Standard configuration (active lines — replace placeholders, especially secrets)
# =============================================================================

# Wallet type: "cantor8" (default) or "canton" (Loop SDK)
VITE_WALLET_TYPE=cantor8

# Network (devnet, testnet, mainnet)
VITE_APP_NETWORK=devnet

# Loop wallet network when using canton wallet (local, devnet, testnet, mainnet)
VITE_LOOP_NETWORK=devnet

# TruthOracle DAML package ID on the participant (after DAR upload)
VITE_TRUTHORACLE_PACKAGE_ID=317054909e97d941498386868b69ca6c0938f6e6c97e615cca507466b68bacad

# TruthOracle DAML package *name* (daml.yaml `name:`). The JSON Ledger API active-contracts
# template filter expects a package-name reference ("#truthoracle-v12:Module:Entity"), not a package id.
VITE_TRUTHORACLE_PACKAGE_NAME=truthoracle-v12

# Canton Ledger API base URL (prepare/execute, active-contracts, etc.)
VITE_CANTON_PARTICIPANT_URL=https://api.validator.dev.digik.cantor8.tech/api/ledger

# Keycloak — client_credentials for the Ledger API, the Enterprise Wallet, and the
# Node scripts. The wallet + ledger run with Keycloak auth; tokens are minted
# SERVER-SIDE by the proxies (api/proxy/*.mjs) and scripts, never in the browser.
#
# IMPORTANT: CLIENT_ID / CLIENT_SECRET must NOT use the VITE_ prefix — anything
# VITE_* is compiled into the public JS bundle. Keep the secret server-only.
# URL/REALM aren't secret and stay VITE_ (the dev keycloak proxy target reads it).
VITE_KEYCLOAK_URL=https://auth.dev.digik.cantor8.tech
VITE_KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Participant API vs Loop wallet for transactions in the app
VITE_USE_PARTICIPANT_API=true

# Enterprise Wallet admin party (full party id derived from the wallet's mnemonic).
# Created once by POSTing to wallet-deploy's /api/v1/accounts — see wallet-deploy/README.md.
# REQUIRED: the UI uses this for admin gating (useIsAdmin) and as the actAs/observer party
# for active-contracts queries (Marketplace, MarketCounter lookup); scripts/create-contract.ts
# uses it as the signing party. Without it the marketplace queries throw.
VITE_ENTERPRISE_WALLET_PARTY_ID=

# =============================================================================
# Optional overrides (examples below are commented — uncomment to use)
# =============================================================================

# Enterprise Wallet REST URL (default http://localhost:8080). Used by scripts/create-contract.ts
# (and, once wired, the UI's admin submit path). Override only if the wallet runs elsewhere.
# VITE_ENTERPRISE_WALLET_URL=http://localhost:8080

# `appName` field sent to /api/v1/external/submit (Enterprise Wallet v0.1.28+).
# Defaults to "truthoracle" — should match wallet-deploy/.env CLIENT_ID.
# VITE_ENTERPRISE_WALLET_APP_NAME=truthoracle

# Dev: set to "true" to log active-contracts lookups in the browser console.
# VITE_DEBUG_ACTIVE_CONTRACTS=true

# Optional: a SEPARATE confidential client just for the wallet proxy. If set, the
# wallet proxy prefers these over the shared KEYCLOAK_* above (ledger proxy keeps
# using KEYCLOAK_*). Lets the wallet use a locked-down client distinct from the one
# the ledger/scripts use. All server-only (no VITE_ prefix).
# WALLET_KEYCLOAK_URL=https://auth.dev.digik.cantor8.tech
# WALLET_KEYCLOAK_REALM=master
# WALLET_KEYCLOAK_CLIENT_ID=
# WALLET_KEYCLOAK_CLIENT_SECRET=

# Playground Messenger examples use VALIDATOR_PARTY in c8-knowledge-hub — not read by this app.


# =============================================================================
# DAR upload to the zkpc (MainNet) node — used by `npm run dars:upload`
# =============================================================================
# Admin Ledger API + Keycloak credentials for the dedicated Cantor8 zkpc node.
# Kept separate from VITE_* so the frontend dev config and the MainNet upload
# config can coexist. Client id/secret are shared by Cantor8 in DM.
ZKPC_LEDGER_API_URL=https://api.validator.main.zkpc.cantor8.tech/api/ledger
ZKPC_KEYCLOAK_URL=https://auth.main.zkpc.cantor8.tech
ZKPC_KEYCLOAK_REALM=master
ZKPC_KEYCLOAK_CLIENT_ID=
ZKPC_KEYCLOAK_CLIENT_SECRET=
