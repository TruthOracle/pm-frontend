# TruthOracle Frontend Environment Variables

# Network (devnet, testnet, mainnet)
VITE_APP_NETWORK=devnet

# Loop wallet network for connection (local, devnet, testnet, mainnet)
VITE_LOOP_NETWORK=devnet

# TruthOracle deployed package ID (from Canton participant after DAR upload)
VITE_TRUTHORACLE_PACKAGE_ID=54bb6ae431649ce7e6e422093009054a1675bdd3da8f511f6d260d032ef8b9b3

# Canton Participant Ledger API URL (for Interactive Submission API)
# This is the base URL; /v2/interactive-submission/prepare and /execute are appended
VITE_CANTON_PARTICIPANT_URL=https://api.validator.dev.digik.cantor8.tech/api/ledger

# Optional: Bearer token for Canton participant authentication (static override).
# If set, this is used instead of Keycloak. Prefer Keycloak in non-dev setups.
# VITE_CANTON_PARTICIPANT_TOKEN=your-token-here
VITE_CANTON_PARTICIPANT_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCIgOiAiSldUIiwia2lkIiA6ICJJcVlGMHFRMmR1UXF4TWg2UmRUa1hldzFLQ1dxN3p0aXhWR0laVTNFYklrIn0..tRrgC6LDTzKI-qC8FO_0T7hKanTlPZO6BkYxst3JpQnOXul4_f5e8xds3SHnSUD7D4mK1XTvzL-HUQwl-td2-UGX8Tx8ZMZ8ndrSpRrTPg6ntm2DXbJeAfoGaontmgPzY5uwDz_4iWNgJq0eqQxUQSrXePBQ4_z9SqEgWn842MVPOL3T0PJ7bLDFTWaW5iO0Y4-j7FF19aIGzypANmes923h78d1EYiYJ4lBo9nDU1WElAaXpy6t5p3xaNGA_Z8vmjUycjwWXlUiE5yxXzt1W5jxiHhGzpRqDemInsl7209YLCSoNP1oeIvl6WPOlJk3jucVws7Urvtt3WGXkvvmSw

# Keycloak (IdP) for JWT Bearer auth with Canton Ledger API.
# When set, the app obtains access_token via client_credentials and sends it as Bearer.
# For production, obtain tokens from your backend; do not ship client_secret in the frontend.
VITE_KEYCLOAK_URL=https://auth.dev.digik.cantor8.tech
# VITE_KEYCLOAK_REALM=master
VITE_KEYCLOAK_CLIENT_ID=your-client-id
VITE_KEYCLOAK_CLIENT_SECRET=your-client-secret

# Use Canton Participant API directly instead of Loop wallet for transactions
# Set to "true" to use /v2/interactive-submission/prepare and /execute
# Set to "false" or omit to use Loop wallet (default)
VITE_USE_PARTICIPANT_API=true
