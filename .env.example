# TruthOracle — copy to `.env` and replace placeholders (especially Keycloak secrets).
#
# Required for `npm run dev` + `npm run create:contract`:
#   VITE_TRUTHORACLE_PACKAGE_ID, VITE_CANTON_PARTICIPANT_URL, VITE_KEYCLOAK_URL,
#   VITE_KEYCLOAK_REALM, VITE_KEYCLOAK_CLIENT_ID, VITE_KEYCLOAK_CLIENT_SECRET
# Recommended for `npm run create:contract`: VITE_TRUTHORACLE_ADMIN_PARTY_ID (else built-in dev default).
#
# =============================================================================
# Standard configuration (active lines — replace placeholders, especially secrets)
# =============================================================================

# Wallet type: "cantor8" (default) or "canton" (Loop SDK)
VITE_WALLET_TYPE=cantor8

# Cantor8 wallet origin (must match the wallet popup's origin so we can read
# its postMessages). Defaults to devnet if unset.
#   devnet  -> https://wallet.dev.digik.cantor8.tech
#   mainnet -> https://wallet.cantor8.tech
VITE_CANTOR8_WALLET_ORIGIN=https://wallet.dev.digik.cantor8.tech

# Network (devnet, testnet, mainnet)
VITE_APP_NETWORK=devnet

# Loop wallet network when using canton wallet (local, devnet, testnet, mainnet)
VITE_LOOP_NETWORK=devnet

# TruthOracle DAML package ID on the participant (after DAR upload)
VITE_TRUTHORACLE_PACKAGE_ID=54bb6ae431649ce7e6e422093009054a1675bdd3da8f511f6d260d032ef8b9b3

# Canton Ledger API base URL (prepare/execute, active-contracts, etc.)
VITE_CANTON_PARTICIPANT_URL=https://api.validator.dev.digik.cantor8.tech/api/ledger

# Keycloak — client_credentials for Ledger API and for `npm run create:contract`
VITE_KEYCLOAK_URL=https://auth.dev.digik.cantor8.tech
VITE_KEYCLOAK_REALM=master
VITE_KEYCLOAK_CLIENT_ID=your-client-id
VITE_KEYCLOAK_CLIENT_SECRET=your-client-secret

# Always "true" — transactions go through the Canton Participant API
# (Keycloak service-account token). The wallet popup is only used to capture
# the user's partyId, not to sign.
VITE_USE_PARTICIPANT_API=true

# Prepare `userId` for interactive submission (`npm run create:contract`; script default: sachin if unset).
VITE_PREPARE_USER_ID=sachin

# =============================================================================
# Optional overrides (examples below are commented — uncomment to use)
# =============================================================================

# TruthOracle admin party (full party id). `npm run create:contract` uses this as MarketCounter signatory;
# if unset, the script uses a repo dev default. Not required for the Vite UI unless you rely on it elsewhere.
# VITE_TRUTHORACLE_ADMIN_PARTY_ID=

# Dev: set to "true" to log active-contracts lookups in the browser console.
# VITE_DEBUG_ACTIVE_CONTRACTS=true

# Playground Messenger examples use VALIDATOR_PARTY in c8-knowledge-hub — not read by this app.
